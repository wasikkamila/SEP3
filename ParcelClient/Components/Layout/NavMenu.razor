<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ParcelClient</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @* Not logged in *@
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

        @* Warehouse worker only *@
        <AuthorizeView Roles="Worker">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="parcels">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Parcels
                </NavLink>
            </div>
        </AuthorizeView>

        @* Admin only *@
        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Admin
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>