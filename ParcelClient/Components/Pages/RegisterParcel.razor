@page "/register-parcel"
@using ParcelClient.Services
@inject HttpParcelService ParcelService
@rendermode InteractiveServer

<h3>Register New Parcel</h3>

<EditForm Model="newParcel"
          OnValidSubmit="RegisterAsync"
          FormName="registerParcel">

    <DataAnnotationsValidator />

    <div class="mb-3">
        <label>Volume (m³)</label>
        <InputNumber class="form-control"
                     @bind-Value="newParcel.Volume" />
    </div>

    <div class="mb-3">
        <label>Weight (kg)</label>
        <InputNumber class="form-control"
                     @bind-Value="newParcel.Weight" />
    </div>

    <div class="mb-3">
        <label>Destination</label>
        <InputText class="form-control"
                   @bind-Value="newParcel.Destination" />
    </div>

    <div class="mb-3">
        <label>Registered By User ID</label>
        <InputNumber class="form-control"
                     @bind-Value="newParcel.RegisteredByUserId" />
    </div>

    <button type="submit" class="btn btn-primary"
            disabled="@isSubmitting">
        Register Parcel
    </button>

</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3">
        @message
    </div>
}

@code {
    private CreateParcelRequest newParcel = new();
    private string message = "";
    private bool isSuccess;
    private bool isSubmitting;

    // Register a new parcel
    private async Task RegisterAsync()
    {
        message = "";
        isSuccess = false;

        // Validate parcel information
        if (newParcel.Volume <= 0 ||
            newParcel.Weight <= 0 ||
            string.IsNullOrWhiteSpace(newParcel.Destination) ||
            newParcel.RegisteredByUserId <= 0)
        {
            message = "Please enter valid parcel information.";
            return;
        }

        isSubmitting = true;

        try
        {
            var result = await ParcelService.CreateAsync(newParcel);

            isSuccess = true;
            message = $"Parcel registered successfully! ID: {result.ParcelId}";

            newParcel = new CreateParcelRequest();
        }
        catch (Exception ex)
        {
            message = $"Registration failed: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
